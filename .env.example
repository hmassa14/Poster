# Required for every real run
ANTHROPIC_API_KEY=sk-ant-...

# Email provider (poster.yaml -> publishing.email_provider). Leave unset for dry runs.
BUTTONDOWN_API_KEY=
RESEND_API_KEY=
RESEND_FROM="This Week in AI <hello@example.com>"
RESEND_AUDIENCE_ID=

# Feedback pulled from GitHub Issues (GitHub Actions sets GITHUB_TOKEN automatically)
GITHUB_TOKEN=

# Optional overrides
POSTER_MODEL_MAIN=claude-opus-5
POSTER_MODEL_FAST=claude-sonnet-5
POSTER_FALLBACKS=1
POSTER_SITE_URL=
